def set_motor_config(config_id):
    global motors
    if config_id not in motor_configs:
        raise ValueError("Invalid config ID")

    _reset_all_pwm_and_dir()

    motors = {}
    pins = [int(p) for p in motor_configs[config_id].split(",")]
    for i, name in enumerate(_MOTOR_NAMES):
        motors[name] = {
            "pwm": PWM(Pin(pins[2 * i]), freq=50),
            "dir": Pin(pins[2 * i + 1], Pin.OUT)
        }
        motors[name]["pwm"].duty(0)
        motors[name]["dir"].value(0)


