def buzz(duration, times):
    if times <= 0 or duration <= 0:
        return

    interval = duration / (times * 2)  # ON + OFF cycles

    for _ in range(times):
        buzzer_pin.value(1)
        time.sleep(interval)
        buzzer_pin.value(0)
        time.sleep(interval)


