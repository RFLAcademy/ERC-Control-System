def start_ap():
    ap = network.WLAN(network.AP_IF)
    if not ap.active():          # boot.py may already have started it
        ap.active(True)
        ap.config(essid=AP_SSID, password=AP_PASSWORD,
                  authmode=network.AUTH_WPA_WPA2_PSK)
        while not ap.active():
            time.sleep(0.1)
    ip = ap.ifconfig()[0]
    return ip


# The control page and logo are stored as comment lines at the very
# end of this file (#@P: / #@L:). Comments use no memory when the
# library loads; they are read from the file only when a browser asks.


def _valid_key(k):
    return 0 < len(k) <= 10 and all(c.isalpha() or c.isdigit() for c in k)


def _read_request(conn):
    data = b""
    while b"\r\n\r\n" not in data and len(data) < 2048:
        chunk = conn.recv(512)
        if not chunk:
            break
        data += chunk
    return data


try:
    _LIB_FILE = __file__
except NameError:
    _LIB_FILE = "motor_library.py"
_asset_pos = 0      # where the data lines start in this file (found once)


def _send_asset(conn, tag, header):
    """Send the page / logo stored as #@P: / #@L: lines at the end of this file."""
    global _asset_pos
    conn.sendall(header)
    out = bytearray()
    with open(_LIB_FILE, "rb") as f:
        f.seek(_asset_pos)
        while True:
            pos = f.tell()
            line = f.readline()
            if not line:
                break
            if line.startswith(b"#@"):
                if not _asset_pos:
                    _asset_pos = pos
                if line.startswith(tag):
                    out += binascii.a2b_base64(line[4:].strip())
                    if len(out) >= 1024:
                        conn.sendall(out)
                        out = bytearray()
    if out:
        conn.sendall(out)


def _serve(conn):
    """
    Answer one new connection.
    Returns the socket if it became the WebSocket client, else None.
    """
    try:
        conn.settimeout(0.5)
        req = _read_request(conn)
        lines = req.split(b"\r\n")
        parts = lines[0].split(b" ")
        path = parts[1].decode() if len(parts) > 1 else "/"

        if path == "/ws":
            ws_key = None
            for line in lines[1:]:
                if line.lower().startswith(b"sec-websocket-key:"):
                    ws_key = line.split(b":", 1)[1].strip()
            if ws_key:
                accept = binascii.b2a_base64(hashlib.sha1(
                    ws_key + b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11").digest()).strip()
                conn.sendall(b"HTTP/1.1 101 Switching Protocols\r\n"
                             b"Upgrade: websocket\r\nConnection: Upgrade\r\n"
                             b"Sec-WebSocket-Accept: " + accept + b"\r\n\r\n")
                conn.setblocking(False)
                return conn
            conn.sendall(b"HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n")
        elif path == "/":
            _send_asset(conn, b"#@P:",
                      b"HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n"
                      b"Content-Encoding: gzip\r\nCache-Control: no-cache\r\n"
                      b"Connection: close\r\n\r\n")
        elif path == "/logo.png":
            _send_asset(conn, b"#@L:",
                      b"HTTP/1.1 200 OK\r\nContent-Type: image/png\r\n"
                      b"Cache-Control: max-age=86400\r\nConnection: close\r\n\r\n")
        else:
            conn.sendall(b"HTTP/1.1 404 Not Found\r\nConnection: close\r\n\r\n")
    except OSError:
        pass
    conn.close()
    return None


# -------- server state --------
_srv = None
_ip = ""
_client = None      # the one open WebSocket
_buf = b""
_key = "NONE"
_last_seen = 0
_last_poll = 0
_tap = None         # last newly pressed key, used by tapped()
POLL_MS = 10        # check the browser at most this often


def start_keyboard():
    """Start the hotspot + web page (safe to call many times)."""
    global _srv, _ip
    if _srv:
        return
    _ip = start_ap()

    # After Thonny Stop/Run the old network sockets can take a few
    # seconds to be freed - keep retrying instead of crashing.
    for attempt in range(20):
        s = None
        try:
            gc.collect()                  # frees sockets nobody uses
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind(("0.0.0.0", WEB_PORT))
            s.listen(2)
            s.settimeout(0)               # never wait inside accept()
            _srv = s
            break
        except OSError as e:
            if s:
                s.close()
            if attempt == 0:
                print("Network busy (" + str(e) + ") - waiting for it to free up...")
            time.sleep(0.5)
    else:
        raise OSError("Could not start the control page. "
                      "Press the RESET (EN) button on the ESP32 and try again.")

    print("=" * 46)
    print(" WiFi          :", AP_SSID, "/", AP_PASSWORD)
    print(" Thonny link   : ws://" + _ip + ":" + str(WEBREPL_PORT))
    print(" Robot control : http://" + _ip)
    print("=" * 46)


def _drop_client():
    global _client, _buf
    if _client:
        try:
            _client.close()
        except OSError:
            pass
    _client = None
    _buf = b""


def _shutdown_web():
    """
    Close the control page connection + server. Called when Thonny's
    STOP interrupts the program, so the phone stops sending data into a
    connection nobody reads (that would block WebREPL until a reset).
    """
    global _srv
    stop_all()
    _drop_client()
    if _srv:
        try:
            _srv.close()
        except OSError:
            pass
    _srv = None


_ACK = bytes([0x81, 1, 0x6B])   # "k": tiny reply so the page knows we are alive
_KICK = bytes([0x81, 1, 0x78])  # "x": another device took control


def _read_ws():
    """Read whatever the browser sent. Returns the newest key, or None."""
    global _buf
    try:
        data = _client.recv(128)
    except OSError as e:
        if e.args[0] == errno.EAGAIN:
            data = None                   # nothing new yet
        else:
            _drop_client()
            return "NONE"
    if data == b"":                       # browser closed the tab
        _drop_client()
        return "NONE"
    if data:
        _buf += data

    key = None
    while len(_buf) >= 2:
        opcode = _buf[0] & 0x0F
        length = _buf[1] & 0x7F
        pos = 2
        if length == 126:
            if len(_buf) < 4:
                break
            length = (_buf[2] << 8) | _buf[3]
            pos = 4
        elif length == 127:               # never sent by our page
            _drop_client()
            return "NONE"
        if len(_buf) < pos + 4 + length:
            break                         # frame not complete yet
        mask = _buf[pos:pos + 4]
        payload = bytes(_buf[pos + 4 + i] ^ mask[i & 3] for i in range(length))
        _buf = _buf[pos + 4 + length:]

        if opcode == 8:                   # close
            _drop_client()
            return "NONE"
        if opcode == 1:                   # text = key name
            k = payload.decode().upper()
            if _valid_key(k):
                key = k
    return key


def _poll_web():
    """Handle the browser (new page loads + key messages) and the safety stop."""
    global _client, _key, _last_seen, _tap
    if not _srv:
        return

    try:
        conn, _ = _srv.accept()
    except OSError:
        conn = None
    if conn:
        ws = _serve(conn)
        if ws:
            if _client:                   # only one controller at a time:
                try:                      # tell the old page it was replaced
                    _client.send(_KICK)
                except OSError:
                    pass
            _drop_client()
            _client = ws
            _last_seen = time.ticks_ms()
            print("Controller connected")

    if _client:
        k = _read_ws()
        if k is not None:
            _last_seen = time.ticks_ms()
            if _client:
                try:
                    _client.send(_ACK)
                except OSError:
                    pass
            if k != _key:
                _key = k
                if k == "NONE":
                    stop_drive()          # all keys released -> stop
                else:
                    _tap = k              # remembered for tapped()

    if _key != "NONE" and \
            time.ticks_diff(time.ticks_ms(), _last_seen) > KEY_TIMEOUT_MS:
        print("Controller silent - stopping")
        stop_drive()
        _key = "NONE"


def get_key():
    """
    Returns the key held down in the browser right now,
    e.g. "A", "UP", "SPACE" - or "NONE" if no key is pressed.
    """
    try:
        return _get_key()
    except KeyboardInterrupt:           # Thonny STOP
        _shutdown_web()
        raise


def _get_key():
    global _running, _stop_active, _oled_last, _last_poll

    start_keyboard()

    if button_stop.value() == 0:
        check_stop()                      # stops motors, needs START again

    if not _running and button_start.value() == 1:
        _running = True
        _stop_active = False
        _oled_last = None
        print("START pressed - resumed")

    now = time.ticks_ms()
    if time.ticks_diff(now, _last_poll) >= POLL_MS:
        _last_poll = now
        _poll_web()
        # Short pause: the ESP32 only handles WebREPL (Thonny's STOP /
        # Ctrl-C and new Thonny connections) while the program sleeps.
        time.sleep_ms(1)

    if not _running:
        return "NONE"
    return _key


def key(*names):
    """
    True while one of these keys is held in the browser.
        if key("A"):            FW(speed=100)
        if key("UP", "W"):      FW(speed=100)
    """
    return get_key() in names


def tapped(*names):
    """
    True only ONCE each time one of these keys is pressed
    (holding it does not repeat). Good for on/off buttons:
        if tapped("L"):         led_toggle()
    """
    global _tap
    get_key()
    if _running and _tap in names:
        _tap = None
        return True
    return False


def horn(on):
    """Buzzer on/off.  horn(key("H")) = beep while H is held."""
    buzzer_pin.value(1 if on else 0)


def led_toggle():
    led_warning.value(0 if led_warning.value() else 1)


def _call_key(on_key, key):
    try:
        on_key(key)
    except Exception as e:
        stop_drive()
        print("Error in on_key(" + key + "):")
        sys.print_exception(e)


def start_keyboard_control(on_key):
    """
    Alternative style: on_key(key) is called once per new key press.
    Runs forever.
    """
    global _running, _stop_active
    _running = True
    _stop_active = False
    last = "NONE"
    try:
        while True:
            k = get_key()
            if k != last:
                last = k
                if k != "NONE":
                    _call_key(on_key, k)
    finally:
        stop_all()


