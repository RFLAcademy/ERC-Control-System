# WIRELESS KEYBOARD CONTROL
# ----------------------------------------------------------------
# The ESP32 hosts a hotspot + a small web page. Open the page on a
# laptop / phone connected to the hotspot and press keys.
#
#   main.py:
#       wait_for_start()
#       while True:
#           if key("A"):
#               FW(speed=100)
#           else:
#               stop_drive()
#
# Key names (use with key("...")):
#   Letters  : "A" .. "Z"           Numbers : "0" .. "9"
#   Top row  : "ESC" "F1" .. "F12" "PRTSC" "INS" "DEL"
#   Arrows   : "UP" "DOWN" "LEFT" "RIGHT"
#   Diagonals: "UPLEFT" "UPRIGHT" "DOWNLEFT" "DOWNRIGHT"
#              (gamepad diagonal buttons, or holding UP + LEFT etc.)
#   Extra motor (gamepad top bar): "EXTRAUP" "EXTRADOWN"
#   Edit     : "BACKSPACE" "TAB" "CAPSLOCK" "ENTER" "SPACE"
#   Modifiers: "SHIFT" "CTRL" "ALT" "WIN" "FN" (FN: on-screen key only)
#   Nav      : "HOME" "END" "PGUP" "PGDN"
#   Symbols  : "BACKQUOTE" (`)  "MINUS" (-)  "EQUAL" (=)
#              "LBRACKET" ([)  "RBRACKET" (])  "BACKSLASH" (\)
#              "SEMICOLON" (;)  "QUOTE" (')  "COMMA" (,)
#              "PERIOD" (.)  "SLASH" (/)
#   get_key() gives "NONE" when no key is pressed.
# When all keys are released the robot stops automatically.
#
# The page keeps ONE WebSocket connection open (no new connection
# per key), so WiFi / WebREPL stay stable.
# ================================================================

