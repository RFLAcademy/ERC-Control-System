import framebuf

class SSD1306(framebuf.FrameBuffer):
    # Uses MicroPython's built-in framebuf (font included) - small and fast
    def __init__(self, width, height, i2c, addr=0x3C):
        self.width = width
        self.height = height
        self.i2c = i2c
        self.addr = addr
        self.buffer = bytearray(width * height // 8)
        super().__init__(self.buffer, width, height, framebuf.MONO_VLSB)
        self._init_display()

    def _cmd(self, cmd):
        self.i2c.writeto(self.addr, bytearray([0x00, cmd]))

    def _init_display(self):
        for cmd in (0xAE, 0x20, 0x00, 0x40, 0xA1, 0xC8, 0x81, 0x7F,
                    0xA8, 0x3F, 0xD3, 0x00, 0xD5, 0x80, 0xD9, 0xF1,
                    0xDA, 0x12, 0xDB, 0x40, 0x8D, 0x14, 0xA4, 0xA6, 0xAF):
            self._cmd(cmd)

    def show(self):
        for page in range(8):
            self._cmd(0xB0 + page)
            self._cmd(0x00)
            self._cmd(0x10)
            start = page * self.width
            self.i2c.writeto(self.addr,
                             bytearray([0x40]) + self.buffer[start:start + self.width])


