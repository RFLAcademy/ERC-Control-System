MIN_DUTY = 520   # tune between 200–350 depending on motors

def _calc_duty(speed):
    speed = max(0, min(100, speed))
    if speed == 0:
        return 0
    duty = int(speed * 1023 // 100)
    return max(duty, MIN_DUTY)


def FW(speed=100):
